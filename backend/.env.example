ECM_MAYAN_API_URL=https://archeoecm.cs.uwindsor.ca/api/v4/
ECM_REQUEST_TIMEOUT=10
# JSON list; no trailing slashes. Local browser origins only.
ECM_TRUSTED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://127.0.0.1:8001","http://localhost:8001"]
ECM_COOKIE_SECURE=false
ECM_SESSION_SECONDS=3600
ECM_DATABASE_PATH=./data/archeoecm.db

# Smart search works in deterministic standard mode until a provider is enabled.
ECM_AI_PROVIDER=disabled
ECM_AI_MODEL=gpt-6-luna
# Keep the real key only in the server's private .env file. Never commit it.
# ECM_AI_API_KEY=
ECM_AI_TIMEOUT=20
ECM_AI_SEARCHES_PER_MINUTE=10
ECM_AI_SEARCHES_PER_DAY=200
