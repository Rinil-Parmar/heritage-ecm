# Template only: retain the existing VM credentials when redeploying.
COMPOSE_PROJECT_NAME=archeoecm
COMPOSE_PROFILES=all_in_one,postgresql,rabbitmq,redis
MAYAN_FRONTEND_HTTP_PORT=127.0.0.1:8080
MAYAN_DOCKER_IMAGE_TAG=s4.12
MAYAN_DATABASE_NAME=mayan
MAYAN_DATABASE_USER=mayan
MAYAN_DATABASE_PASSWORD=replace-before-first-install
MAYAN_RABBITMQ_USER=mayan
MAYAN_RABBITMQ_PASSWORD=replace-before-first-install
MAYAN_RABBITMQ_VHOST=mayan
MAYAN_REDIS_PASSWORD=replace-before-first-install
MAYAN_DOCKER_CPU_LIMIT=4.0
MAYAN_DOCKER_CPU_RESERVATION=2.0
MAYAN_TRAEFIK_EXTERNAL_DOMAIN=archeoecm.cs.uwindsor.ca
